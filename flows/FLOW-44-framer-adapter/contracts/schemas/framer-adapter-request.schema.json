{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLOW-44 Framer Text Elements Adapter Request",
  "type": "object",
  "required": ["runId", "nodes"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "text": { "type": "string" },
          "characters": { "type": "string" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "fontFamily": { "type": "string" },
          "fontSize": { "type": ["number", "string"] },
          "fontWeight": { "type": ["number", "string"] },
          "lineHeight": { "type": ["number", "string"] },
          "letterSpacing": { "type": ["number", "string"] },
          "color": {},
          "fills": { "type": "array" },
          "opacity": { "type": "number" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
