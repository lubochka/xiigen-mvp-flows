{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiigen.local/contracts/FLOW-10/reviews-reputation-request.schema.json",
  "title": "FLOW-10 Reviews Reputation Request",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "reviewerId": { "type": "string", "minLength": 1 },
    "targetEntityId": { "type": "string", "minLength": 1 },
    "targetEntityType": { "type": "string", "minLength": 1 },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reviewText": { "type": "string", "minLength": 1 },
    "eligibilityConfirmed": { "type": "boolean" },
    "checkInConfirmed": { "type": "boolean" },
    "purchaseConfirmed": { "type": "boolean" },
    "reviewId": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ownerId": { "type": "string" },
    "ownerConfirmed": { "type": "boolean" },
    "responseText": { "type": "string" },
    "contentPolicyPassed": { "type": "boolean" },
    "allowRevision": { "type": "boolean" },
    "simulateSlowWrite": { "type": "boolean" },
    "simulateFabricTimeout": { "type": "boolean" }
  }
}
