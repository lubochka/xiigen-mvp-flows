{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiigen.local/contracts/FLOW-19/durable-sagas-compliance-response.schema.json",
  "title": "FLOW-19 Durable Sagas Compliance Response",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "sagaId": { "type": "string" },
    "auditId": { "type": "string" },
    "exportId": { "type": "string" },
    "status": { "type": "string" },
    "version": { "type": "string" },
    "currentVersion": { "type": "string" },
    "currentStepIndex": { "type": "integer" },
    "stepCount": { "type": "integer" },
    "stepIndex": { "type": "integer" },
    "stepId": { "type": "string" },
    "executed": { "type": "array" },
    "eventType": { "type": "string" },
    "retentionExpiresAt": { "type": "string" },
    "auditHash": { "type": "string" },
    "knowledgeScope": { "type": "string", "enum": ["PRIVATE", "PLATFORM_ONLY"] },
    "archiveRef": { "type": "string" },
    "delivery": { "type": "string", "enum": ["DOWNLOAD", "EMAIL_LINK"] },
    "format": { "type": "string" },
    "retryAfterMs": { "type": "integer" },
    "code": { "type": "string" },
    "message": { "type": "string" },
    "details": { "type": "array" },
    "items": { "type": "array" },
    "kpis": { "type": "object", "additionalProperties": true },
    "sagaRuns": { "type": "array" },
    "complianceRecords": { "type": "array" },
    "compensationRecords": { "type": "array" },
    "retentionArchives": { "type": "array" }
  }
}
