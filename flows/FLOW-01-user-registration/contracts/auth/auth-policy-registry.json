{
  "policies": [
    {
      "name": "UserRegistrationPublic",
      "serverPolicy": "AllowAnonymous",
      "angularGuard": "configLoadedGuard + tenantGuard",
      "allowedRoles": [],
      "tenantScoped": true,
      "anonymousAllowed": true,
      "bypassPaths": [
        "/api/dynamic/user-registration",
        "/api/dynamic/user-registration/verify-token",
        "/api/dynamic/user-registration/resend"
      ]
    },
    {
      "name": "UserRegistrationOnboarding",
      "serverPolicy": "RequireRole:tenant_user,tenant_admin,platform_admin",
      "angularGuard": "configLoadedGuard + authGuard + tenantGuard",
      "allowedRoles": [
        "tenant_user",
        "tenant_admin",
        "platform_admin"
      ],
      "tenantScoped": true,
      "anonymousAllowed": false,
      "bypassPaths": []
    },
    {
      "name": "UserRegistrationReadOnly",
      "serverPolicy": "RequireRole:tenant_admin,platform_admin,platform_support",
      "angularGuard": "configLoadedGuard + authGuard + tenantGuard",
      "allowedRoles": [
        "tenant_admin",
        "platform_admin",
        "platform_support"
      ],
      "tenantScoped": true,
      "anonymousAllowed": false,
      "bypassPaths": []
    },
    {
      "name": "UserRegistrationHealthBypass",
      "serverPolicy": "AllowAnonymous",
      "angularGuard": "none",
      "allowedRoles": [],
      "tenantScoped": false,
      "anonymousAllowed": true,
      "bypassPaths": [
        "/health/live",
        "/health/ready"
      ]
    }
  ]
}
