{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiigen.local/contracts/flow-08/marketplace-request.schema.json",
  "title": "FLOW-08 Marketplace Listing Request",
  "type": "object",
  "required": ["listingId", "sellerId", "title", "category", "price"],
  "additionalProperties": true,
  "properties": {
    "listingId": { "type": "string", "minLength": 1 },
    "sellerId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "price": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "inventory": { "type": "integer", "minimum": 0 },
    "moderationSignal": { "type": "string" },
    "views": { "type": "integer", "minimum": 0 },
    "inquiries": { "type": "integer", "minimum": 0 },
    "maxPriceCap": { "type": "number", "minimum": 0 },
    "simulateSlowWrite": { "type": "boolean" },
    "simulateFabricTimeout": { "type": "boolean" }
  }
}
