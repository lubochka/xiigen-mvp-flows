{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLOW-43 Webflow Designer Extension Request",
  "type": "object",
  "required": ["runId", "elements"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "elementType", "name", "properties", "nativeCss"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "elementType": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "properties": { "type": "object", "additionalProperties": { "type": "string" } },
          "nativeCss": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
