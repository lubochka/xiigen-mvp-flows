{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Intelligence Engine Request",
  "type": "object",
  "additionalProperties": true,
  "not": {
    "anyOf": [
      { "required": ["tenantId"] },
      { "required": ["tenant_id"] },
      { "required": ["ownerTenantId"] },
      { "required": ["owner_tenant_id"] }
    ]
  },
  "properties": {
    "designFileKey": { "type": "string", "minLength": 1 },
    "screenName": { "type": "string", "minLength": 1 },
    "componentMap": { "type": "object", "minProperties": 1 },
    "tokenSet": { "type": "object", "minProperties": 1 },
    "requestedBy": { "type": "string", "minLength": 1 },
    "confidenceScore": { "type": "integer", "minimum": 1 },
    "simulateTimeout": { "type": "boolean" },
    "rules": { "type": "array" },
    "planSteps": { "type": "array" }
  }
}
