{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiigen.local/schemas/FLOW-41/canva-text-adapter-request.schema.json",
  "title": "Canva Text Adapter Request",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "canvaElements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content", "fontSize", "fontStyle", "textAlign", "color", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "fontSize": { "type": "number", "minimum": 0 },
          "fontStyle": {
            "type": "object",
            "required": ["family", "weight"],
            "properties": {
              "family": { "type": "string", "minLength": 1 },
              "weight": { "type": "integer", "enum": [400, 700] }
            }
          },
          "textAlign": { "type": "string", "enum": ["start", "center", "end"] },
          "color": {
            "type": "object",
            "required": ["r", "g", "b"],
            "properties": {
              "r": { "type": "integer", "minimum": 0, "maximum": 255 },
              "g": { "type": "integer", "minimum": 0, "maximum": 255 },
              "b": { "type": "integer", "minimum": 0, "maximum": 255 }
            }
          },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 }
        }
      }
    },
    "enhanced": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content", "style"],
        "properties": {
          "content": { "type": "string" },
          "style": {
            "type": "object",
            "required": ["fontSize", "fontFamily", "fontWeight", "textAlignHorizontal", "color"],
            "properties": {
              "fontSize": { "type": "number", "minimum": 0 },
              "fontFamily": { "type": "string", "minLength": 1 },
              "fontWeight": { "type": "string", "enum": ["Bold", "Regular"] },
              "textAlignHorizontal": { "type": "string", "enum": ["LEFT", "CENTER", "RIGHT"] },
              "color": { "type": "string", "pattern": "^rgb\\([0-9]{1,3}, [0-9]{1,3}, [0-9]{1,3}\\)$" }
            }
          }
        }
      }
    },
    "packageName": { "type": "string", "const": "@xiigen/canva-text-elements-adapter" },
    "version": { "type": "string", "const": "1.0.1" },
    "includesStep1Invariants": { "type": "boolean" },
    "includesFunctionalSpec": { "type": "boolean" },
    "localRegistryReadback": { "type": "boolean" },
    "approvedForTenantAdoption": { "type": "boolean" },
    "pricingModel": { "type": "string", "enum": ["PER_USE"] },
    "rules": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "planSteps": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
